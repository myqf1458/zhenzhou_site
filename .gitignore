# ============================================================
# 真昼小站 - Git 忽略规则
# ============================================================

# ============== 敏感配置（包含数据库/SMTP/QQ 等凭证） ==============
# 本地配置文件 - 由安装向导生成或手动复制 config.example.php 创建
config.local.php

# 安装向导锁文件（标记系统已安装）
admin/install.lock

# ============== 日志文件 ==============
*.log
smtp_error.log
php_error.log

# ============== 编辑器/IDE ==============
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ============== 依赖与缓存 ==============
node_modules/
vendor/
composer.lock
package-lock.json

# ============== 临时文件与备份 ==============
*.tmp
*.bak
*.cache
~$*

# ============== 上传文件（运行时生成） ==============
uploads/
upload/

# ============== 提示：QQ 互联配置 ==============
# qq_oauth_config.php 默认为空配置占位符（enabled=0），可安全提交。
# 若你在该文件中填入了真实的 app_id/app_key，请取消下行注释以避免泄露：
# qq_oauth_config.php
